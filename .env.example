# ==============================================================================
# D.E.E.P (Dynamic Executive Edge Platform) - Environment Configuration Template
# Copy this file to '.env' and fill in your values: cp .env.example .env
# NEVER commit your actual '.env' file to version control!
# ==============================================================================

# -----------------------------------------------------------------------------
# 1. Core Server & Host Configuration
# -----------------------------------------------------------------------------
PORT=5000
HOST=127.0.0.1
DEBUG=False
SECRET_KEY=generate_a_secure_random_key_here

# -----------------------------------------------------------------------------
# 2. Local LLM & AI Engine (Ollama / Local Inference)
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
DEFAULT_LLM_MODEL=llama3.2:latest
VISION_MODEL=llava:latest
COGNITIVE_CO_PILOT_MODE=DUAL_JARVIS_FRIDAY

# -----------------------------------------------------------------------------
# 3. Database & Epistemic Vector Storage
# -----------------------------------------------------------------------------
# PostgreSQL (Optional - SQLite fallback is automatic)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/deep_db
DB_PASSWORD=your_db_password_here

# Vector Storage (Qdrant / Redis via docker-compose)
QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 4. Messaging & Telemetry Integrations (Optional)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Autonomous Assistant (IMAP / SMTP)
EMAIL_ADDRESS=your_email@example.com
EMAIL_PASSWORD=your_app_specific_password_here
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
IMAP_PORT=993
SMTP_PORT=465

# -----------------------------------------------------------------------------
# 5. Smart Home & IoT (TP-Link Kasa)
# -----------------------------------------------------------------------------
KASA_DEVICE_IP=192.168.1.100

# -----------------------------------------------------------------------------
# 6. Embedded Hardware (Microchip PIC18F / PICkit 3)
# -----------------------------------------------------------------------------
PICKIT_DEVICE=PIC18F85K22
PICKIT_SERIAL=BUR181916585
MPLABX_IPECMD_PATH=C:\Program Files\Microchip\MPLABX\v6.00\sys\mplabclassic\ipecmd.exe
XC8_COMPILER_PATH=C:\Program Files\Microchip\xc8\v2.40\bin\xc8-cc.exe
